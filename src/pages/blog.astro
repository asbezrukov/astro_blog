---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "My Astro Learning Blog";
const pageDescription = "This is where I will post about my journey learning Astro.";

const posts = [
  { title: "Post 1", url: "posts/post-1/" },
  { title: "Post 2", url: "posts/post-2/" },
  { title: "Post 3", url: "posts/post-3/" },
];
---
<BaseLayout pageTitle={pageTitle}>
    <p>This is where I will post about my journey learning Astro.</p>
    <ul>
        {posts.map((post)=> <li><a href={post.url}>{post.title}</a></li>)}
    </ul>
</BaseLayout>


    
    